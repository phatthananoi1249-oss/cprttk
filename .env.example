# =========================================================================
# MEGA Code Clock - Environment Variables Configuration
# =========================================================================

# -------------------------------------------------------------------------
# ตัวเลือกที่ 1: เชื่อมต่อผ่าน Google Apps Script Web App (แนะนำ - ติดตั้งง่ายสุด)
# -------------------------------------------------------------------------
# นำ Web App URL ที่ได้จากการ Deploy ใน Apps Script มาวางที่นี่
GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/AKfycbx.../exec

# สำหรับ Fallback ฝั่ง Client
NEXT_PUBLIC_GOOGLE_SHEETS_URL=https://script.google.com/macros/s/AKfycbx.../exec

# -------------------------------------------------------------------------
# ตัวเลือกที่ 2: เชื่อมต่อผ่าน Google Cloud Service Account (ใช้ร่วมกับ key.json)
# -------------------------------------------------------------------------
# ใส่ Spreadsheet ID ของ Google Sheet (หาได้จาก URL ระหว่าง /d/ และ /edit)
# เช่น https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit
GOOGLE_SHEET_ID=
NEXT_PUBLIC_GOOGLE_SHEET_ID=
